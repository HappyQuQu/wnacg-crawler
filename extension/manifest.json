{
  "manifest_version": 3,
  "name": "WNACG 下载器",
  "short_name": "WNACG",
  "version": "2.0.0",
  "description": "连接 WNACG 下载后台，添加漫画并查看服务器文件与下载记录。",
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://www.wnacg.com/*",
    "https://wnacg.com/*",
    "https://www.wnacg.org/*",
    "https://wnacg.org/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.wnacg.com/*",
        "https://wnacg.com/*",
        "https://www.wnacg.org/*",
        "https://wnacg.org/*"
      ],
      "js": [
        "dist/content.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/icon.svg"],
      "matches": [
        "https://www.wnacg.com/*",
        "https://wnacg.com/*",
        "https://www.wnacg.org/*",
        "https://wnacg.org/*"
      ]
    }
  ],
  "action": {
    "default_title": "WNACG 下载器",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
