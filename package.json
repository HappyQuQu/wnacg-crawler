{
  "name": "wnacg-downloader-workspace",
  "version": "2.0.0-dev",
  "private": true,
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "workspaces": [
    "frontend",
    "extension"
  ],
  "scripts": {
    "dev:frontend": "npm run dev -w frontend",
    "build:frontend": "npm run build -w frontend",
    "build:extension": "npm run build -w extension",
    "package:extension": "bash scripts/package-extension.sh",
    "typecheck:extension": "npm run typecheck -w extension",
    "validate": "bash scripts/validate.sh"
  },
  "license": "MIT"
}
